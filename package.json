{
  "name": "dsh-session-snapshot",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that keeps rolling, integrity-verified backups of each session at turn boundaries, so any corruption costs at most the in-flight turn; one-command restore, even when dsh won't boot",
  "type": "module",
  "bin": {
    "dsh-session-snapshot": "lib/cli.js"
  },
  "main": "lib/api.js",
  "types": "lib/api.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/po-et/dsh-session-snapshot.git"
  },
  "homepage": "https://github.com/po-et/dsh-session-snapshot#readme",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npx -y @deepseek-ai/dsh web --patch ./dev.cordis.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "backup",
    "snapshot",
    "recovery"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
